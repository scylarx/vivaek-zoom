# Copy to .env.local. Never commit .env.local.

# Sanity (wave 3 — set when CMS is wired up)
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_API_READ_TOKEN=

# Resend (wave 3 — set when contact/RSVP forms are wired up)
RESEND_API_KEY=

# Cloudflare R2 (wave 3 — audio hosting)
R2_ACCOUNT_ID=
R2_BUCKET=
R2_PUBLIC_URL=

# Spotify (wave 3 — only for oEmbed metadata, not playback)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3001
