# Copy to .env.local. Never commit .env.local.

# Sanity
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_API_READ_TOKEN=
# Sanity Studio reads these separately (SANITY_STUDIO_ prefix)
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production

# Resend — contact form
RESEND_API_KEY=
CONTACT_DESTINATION_EMAIL=
# Sender address. Use onboarding@resend.dev during dev; replace with a verified
# domain address (e.g. no-reply@odissisydney.com) before going live.
RESEND_FROM_EMAIL=onboarding@resend.dev

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
