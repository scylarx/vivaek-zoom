# Copy to .env.local. Never commit .env.local.

# Sanity
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_API_READ_TOKEN=
# Sanity Studio reads these separately (SANITY_STUDIO_ prefix)
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production

# Contact form endpoint
# Currently Basin (https://usebasin.com). Create a form, paste its endpoint URL
# (e.g. https://usebasin.com/f/abc123xyz45). Destination email(s) are configured
# in the Basin dashboard, not here. Service-agnostic name so we can swap later.
CONTACT_FORM_ENDPOINT=

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
